{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seuraphotos.app/schema/edit/1.0.json",
  "title": "Seura Edit Format 1.0",
  "description": "Non-destructive edits, tags, and rating for one photo, or a preset. See spec/edit-format.md. Some rules can't be expressed in JSON Schema and must be checked in code: canonical operation order, each operation id appearing at most once, and tags not differing only in letter case.",
  "type": "object",
  "required": ["format", "formatVersion"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "format": { "const": "seura-edit" },
    "formatVersion": { "const": "1.0" },
    "kind": {
      "description": "Absent for a photo's edit file; \"preset\" for a preset.",
      "const": "preset"
    },
    "name": { "description": "Preset name. Presets only.", "type": "string", "minLength": 1 },
    "writer": {
      "type": "object",
      "properties": {
        "app": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": true
    },
    "modified": { "type": "string", "format": "date-time" },
    "photo": { "$ref": "#/$defs/photo" },
    "operations": {
      "type": "array",
      "items": { "$ref": "#/$defs/operation" }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tag" }
    },
    "rating": { "type": "integer", "minimum": 0, "maximum": 5 },
    "history": {
      "type": "array",
      "items": { "$ref": "#/$defs/historyRecord" }
    },
    "extensions": {
      "description": "Non-operation data, keyed by reverse domain name. Readers preserve it unchanged.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/reverseDomainName" }
    }
  },
  "additionalProperties": false,
  "if": {
    "properties": { "kind": { "const": "preset" } },
    "required": ["kind"]
  },
  "then": {
    "required": ["name"],
    "not": {
      "anyOf": [
        { "required": ["photo"] },
        { "required": ["tags"] },
        { "required": ["rating"] },
        { "required": ["history"] }
      ]
    }
  },
  "else": {
    "required": ["photo"],
    "not": { "required": ["name"] }
  },

  "$defs": {
    "fraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "reverseDomainName": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[A-Za-z0-9-]+)+$"
    },
    "tag": {
      "description": "Slash-separated levels for display; each full string is a separate tag. No leading or trailing spaces or slashes, and no empty levels.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s/])(?!.*//)(?!.*[\\s/]$).+$"
    },
    "photo": {
      "type": "object",
      "required": ["file", "sha256", "size", "width", "height"],
      "properties": {
        "file": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },

    "operation": {
      "type": "object",
      "required": ["id", "version", "params"],
      "properties": {
        "id": { "$ref": "#/$defs/reverseDomainName" },
        "version": { "type": "integer", "minimum": 1 },
        "params": { "type": "object" },
        "enabled": { "type": "boolean" },
        "group": { "enum": ["geometry", "retouch", "tone", "effects"] },
        "required": { "type": "boolean" }
      },
      "additionalProperties": false,
      "if": {
        "properties": { "id": { "pattern": "^seura\\." } }
      },
      "then": {
        "description": "Core operation: id must be one defined by this version; group and required are not used.",
        "properties": {
          "id": { "enum": [
            "seura.orient", "seura.straighten", "seura.crop", "seura.redEye",
            "seura.exposure", "seura.whiteBalance", "seura.contrast", "seura.saturation",
            "seura.blackAndWhite", "seura.sepia", "seura.vignette"
          ] }
        },
        "not": { "anyOf": [ { "required": ["group"] }, { "required": ["required"] } ] },
        "allOf": [
          { "$ref": "#/$defs/coreParams" }
        ]
      },
      "else": {
        "description": "Non-core (plugin or third-party) operation: group is required; params are defined by the operation's author.",
        "required": ["group"]
      }
    },

    "coreParams": {
      "description": "Parameter rules for version 1 of each core operation. Other versions are validated only for shape.",
      "allOf": [
        { "$ref": "#/$defs/opOrient" },
        { "$ref": "#/$defs/opStraighten" },
        { "$ref": "#/$defs/opCrop" },
        { "$ref": "#/$defs/opRedEye" },
        { "$ref": "#/$defs/opExposure" },
        { "$ref": "#/$defs/opWhiteBalance" },
        { "$ref": "#/$defs/opContrast" },
        { "$ref": "#/$defs/opSaturation" },
        { "$ref": "#/$defs/opBlackAndWhite" },
        { "$ref": "#/$defs/opSepia" },
        { "$ref": "#/$defs/opVignette" }
      ]
    },

    "opOrient": {
      "if": { "properties": { "id": { "const": "seura.orient" }, "version": { "const": 1 } } },
      "then": { "properties": { "params": {
        "type": "object",
        "required": ["rotate", "flipH", "flipV"],
        "properties": {
          "rotate": { "enum": [0, 90, 180, 270] },
          "flipH": { "type": "boolean" },
          "flipV": { "type": "boolean" }
        },
        "additionalProperties": false
      } } }
    },
    "opStraighten": {
      "if": { "properties": { "id": { "const": "seura.straighten" }, "version": { "const": 1 } } },
      "then": { "properties": { "params": {
        "type": "object",
        "required": ["angle"],
        "properties": { "angle": { "type": "number", "minimum": -45, "maximum": 45 } },
        "additionalProperties": false
      } } }
    },
    "opCrop": {
      "if": { "properties": { "id": { "const": "seura.crop" }, "version": { "const": 1 } } },
      "then": { "properties": { "params": {
        "type": "object",
        "required": ["x", "y", "width", "height"],
        "properties": {
          "x": { "$ref": "#/$defs/fraction" },
          "y": { "$ref": "#/$defs/fraction" },
          "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "aspect": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$" }
            ]
          }
        },
        "additionalProperties": false
      } } }
    },
    "opRedEye": {
      "if": { "properties": { "id": { "const": "seura.redEye" }, "version": { "const": 1 } } },
      "then": { "properties": { "params": {
        "type": "object",
        "required": ["regions"],
        "properties": {
          "regions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["x", "y", "radius"],
              "properties": {
                "x": { "$ref": "#/$defs/fraction" },
                "y": { "$ref": "#/$defs/fraction" },
                "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      } } }
    },
    "opExposure": {
      "if": { "properties": { "id": { "const": "seura.exposure" }, "version": { "const": 1 } } },
      "then": { "properties": { "params": {
        "type": "object",
        "required": ["ev"],
        "properties": { "ev": { "type": "number", "minimum": -4, "maximum": 4 } },
        "additionalProperties": false
      } } }
    },
    "opWhiteBalance": {
      "if": { "properties": { "id": { "const": "seura.whiteBalance" }, "version": { "const": 1 } } },
      "then": { "properties": { "params": {
        "type": "object",
        "required": ["temperature", "tint"],
        "properties": {
          "temperature": { "type": "number", "minimum": -100, "maximum": 100 },
          "tint": { "type": "number", "minimum": -100, "maximum": 100 }
        },
        "additionalProperties": false
      } } }
    },
    "opContrast": {
      "if": { "properties": { "id": { "const": "seura.contrast" }, "version": { "const": 1 } } },
      "then": { "properties": { "params": {
        "type": "object",
        "required": ["amount"],
        "properties": { "amount": { "type": "number", "minimum": -100, "maximum": 100 } },
        "additionalProperties": false
      } } }
    },
    "opSaturation": {
      "if": { "properties": { "id": { "const": "seura.saturation" }, "version": { "const": 1 } } },
      "then": { "properties": { "params": {
        "type": "object",
        "required": ["amount"],
        "properties": { "amount": { "type": "number", "minimum": -100, "maximum": 100 } },
        "additionalProperties": false
      } } }
    },
    "opBlackAndWhite": {
      "if": { "properties": { "id": { "const": "seura.blackAndWhite" }, "version": { "const": 1 } } },
      "then": { "properties": { "params": {
        "type": "object",
        "required": ["strength"],
        "properties": { "strength": { "type": "number", "minimum": 0, "maximum": 100 } },
        "additionalProperties": false
      } } }
    },
    "opSepia": {
      "if": { "properties": { "id": { "const": "seura.sepia" }, "version": { "const": 1 } } },
      "then": { "properties": { "params": {
        "type": "object",
        "required": ["strength"],
        "properties": { "strength": { "type": "number", "minimum": 0, "maximum": 100 } },
        "additionalProperties": false
      } } }
    },
    "opVignette": {
      "if": { "properties": { "id": { "const": "seura.vignette" }, "version": { "const": 1 } } },
      "then": { "properties": { "params": {
        "type": "object",
        "required": ["amount", "size"],
        "properties": {
          "amount": { "type": "number", "minimum": -100, "maximum": 100 },
          "size": { "type": "number", "minimum": 0, "maximum": 100 }
        },
        "additionalProperties": false
      } } }
    },

    "historyRecord": {
      "type": "object",
      "required": ["at", "changes"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "label": { "type": "string" },
        "undone": { "description": "Present and true when the record has been undone and not redone. Undone records are always last.", "const": true },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "description": "An operation was added, changed, or removed. null means absent.",
                "type": "object",
                "required": ["op", "from", "to"],
                "properties": {
                  "op": { "$ref": "#/$defs/reverseDomainName" },
                  "from": { "type": ["object", "null"] },
                  "to": { "type": ["object", "null"] }
                },
                "additionalProperties": false
              },
              {
                "description": "The tags changed.",
                "type": "object",
                "required": ["field", "from", "to"],
                "properties": {
                  "field": { "const": "tags" },
                  "from": { "type": "array", "items": { "$ref": "#/$defs/tag" } },
                  "to": { "type": "array", "items": { "$ref": "#/$defs/tag" } }
                },
                "additionalProperties": false
              },
              {
                "description": "The rating changed.",
                "type": "object",
                "required": ["field", "from", "to"],
                "properties": {
                  "field": { "const": "rating" },
                  "from": { "type": "integer", "minimum": 0, "maximum": 5 },
                  "to": { "type": "integer", "minimum": 0, "maximum": 5 }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
